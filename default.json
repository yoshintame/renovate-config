{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for yoshintame repositories",
  "extends": ["config:best-practices"],
  "timezone": "Asia/Bangkok",
  "schedule": ["* 0-3 1-7,15-21 * 1"],
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "One batch for every non-major update",
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"]
    },
    {
      "description": "Major updates wait for approval in the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "hk in mise.toml and the hk package URLs in hk.pkl move together",
      "groupName": "hk",
      "matchPackageNames": ["hk", "jdx/hk"]
    },
    {
      "description": "Own releases arrive at once, without cooldown",
      "groupName": "yoshintame releases",
      "matchPackageNames": ["yoshintame/**", "@yoshintame/**"],
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"],
      "dependencyDashboardApproval": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pkl packages published as GitHub releases, such as hk and hk-config in hk.pkl",
      "managerFilePatterns": ["/(^|/)[^/]*\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v(?<currentValue>[^/\\s]+)/[^@/\\s]+@[^#\"\\s]+"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "YAML values annotated with # renovate: datasource=<datasource> depName=<name>",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*[A-Za-z0-9_-]+:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
