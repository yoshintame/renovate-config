{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for yoshintame repositories",
  "extends": ["config:best-practices"],
  "timezone": "Asia/Bangkok",
  "schedule": ["* * 1-7,15-21 * 1"],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "npm gets the same 7 days as everything else instead of the 3 days of security:minimumReleaseAgeNpm",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Digest updates carry no release timestamp, so they must not wait for one (renovatebot/renovate#45236)",
      "matchUpdateTypes": ["digest", "pinDigest"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "One batch for every non-major update",
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "matchUpdateTypes": ["minor", "patch", "pin"]
    },
    {
      "description": "Major updates wait for approval in the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "hk in mise.toml and the hk package URLs in hk.pkl move together",
      "groupName": "hk",
      "matchPackageNames": ["jdx/hk"]
    },
    {
      "description": "Own releases arrive at once, without cooldown",
      "groupName": "yoshintame releases",
      "matchPackageNames": ["yoshintame/**", "@yoshintame/**"],
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"],
      "dependencyDashboardApproval": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pkl packages published as GitHub releases, such as hk and hk-config in hk.pkl",
      "managerFilePatterns": ["/(^|/)[^/]*\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/v(?<currentValue>[^/\\s]+)/[^@/\\s]+@[^#\"\\s]+"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
